generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique
  password      String
  firstName     String
  lastName      String
  role          Role           @default(USER)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  familyMembers FamilyMember[]
  refreshTokens RefreshToken[]

  // NOU — leagă acest user de UN SINGUR FamilyMember, care reprezintă
  // "eu" în arborele lui. @unique garantează că un membru nu poate fi
  // "eu" pentru doi useri diferiți simultan.
  selfMemberId String?       @unique
  selfMember   FamilyMember? @relation("SelfMember", fields: [selfMemberId], references: [id], onDelete: SetNull)

  ownedShareLinks    ShareLink[]  @relation("OwnedShareLinks")
  ownedTreeAccess    TreeAccess[] @relation("OwnedTreeAccess")
  receivedTreeAccess TreeAccess[] @relation("ReceivedTreeAccess")
  sentInvites        AppInvite[]  @relation("SentInvites")
  acceptedInvite     AppInvite?   @relation("AcceptedInvites")

  conversationParticipants ConversationParticipant[]
  sentMessages             Message[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@map("refresh_tokens")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model FamilyMember {
  id          String           @id @default(uuid())
  firstName   String
  lastName    String
  maidenName  String?
  gender      Gender?
  birthDate   DateTime?
  deathDate   DateTime?
  imageUrl    String?
  bio         String?
  education   String?
  occupation  String?
  bloodType   BloodType?
  heightCm    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  parents     ParentChild[]    @relation("ChildRelation")
  children    ParentChild[]    @relation("ParentRelation")
  partnersA   Partnership[]    @relation("PartnerA")
  partnersB   Partnership[]    @relation("PartnerB")
  manualOrder Int?
  manualRank  Int?
  alliancesA  FamilyAlliance[] @relation("AllianceA")
  alliancesB  FamilyAlliance[] @relation("AllianceB")

  // NOU — reverse relation pentru User.selfMember
  selfOfUser User? @relation("SelfMember")

  @@map("family_members")
}

enum AllianceType {
  CUSCRI
}

model FamilyAlliance {
  id               String       @id @default(uuid())
  memberA          FamilyMember @relation("AllianceA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberAId        String
  memberB          FamilyMember @relation("AllianceB", fields: [memberBId], references: [id], onDelete: Cascade)
  memberBId        String
  type             AllianceType @default(CUSCRI)
  viaPartnershipId String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([memberAId, memberBId])
  @@map("family_alliances")
}

model ParentChild {
  id       String       @id @default(uuid())
  parent   FamilyMember @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    FamilyMember @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)
  childId  String

  @@unique([parentId, childId])
  @@map("parent_child")
}

model Partnership {
  id         String            @id @default(uuid())
  partnerA   FamilyMember      @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerAId String
  partnerB   FamilyMember      @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)
  partnerBId String
  status     PartnershipStatus @default(MARRIED)
  startDate  DateTime?
  endDate    DateTime?

  @@unique([partnerAId, partnerBId])
  @@map("partnerships")
}

enum PartnershipStatus {
  MARRIED
  DIVORCED
  PARTNER
  WIDOWED
}

enum ShareAccessLevel {
  READ_ONLY
  EDIT
}

model ShareLink {
  id                 String           @id @default(uuid())
  token              String           @unique
  owner              User             @relation("OwnedShareLinks", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId            String
  accessLevel        ShareAccessLevel @default(READ_ONLY)
  label              String?
  expiresAt          DateTime?
  maxUses            Int?
  usesCount          Int              @default(0)
  maxMembersPerGuest Int? // NOU — null = nelimitat
  revoked            Boolean          @default(false)
  createdAt          DateTime         @default(now())
  guests             ShareLinkGuest[]

  @@map("share_links")
}

model ShareLinkGuest {
  id                String    @id @default(uuid())
  shareLink         ShareLink @relation(fields: [shareLinkId], references: [id], onDelete: Cascade)
  shareLinkId       String
  guestToken        String    @unique
  displayName       String?
  membersAddedCount Int       @default(0) // NOU
  createdAt         DateTime  @default(now())
  lastUsedAt        DateTime  @default(now())

  @@map("share_link_guests")
}

model TreeAccess {
  id          String           @id @default(uuid())
  owner       User             @relation("OwnedTreeAccess", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  grantee     User             @relation("ReceivedTreeAccess", fields: [granteeId], references: [id], onDelete: Cascade)
  granteeId   String
  accessLevel ShareAccessLevel @default(READ_ONLY)
  expiresAt   DateTime?
  revoked     Boolean          @default(false)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([ownerId, granteeId])
  @@map("tree_access")
}

model AppInvite {
  id           String    @id @default(uuid())
  token        String    @unique
  inviter      User      @relation("SentInvites", fields: [inviterId], references: [id], onDelete: Cascade)
  inviterId    String
  email        String?
  expiresAt    DateTime?
  usedAt       DateTime?
  usedByUser   User?     @relation("AcceptedInvites", fields: [usedByUserId], references: [id], onDelete: SetNull)
  usedByUserId String?   @unique
  createdAt    DateTime  @default(now())

  @@map("app_invites")
}

model Conversation {
  id           String                    @id @default(uuid())
  isGroup      Boolean                   @default(false)
  name         String?
  createdAt    DateTime                  @default(now())
  participants ConversationParticipant[]
  messages     Message[]
}

model ConversationParticipant {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime     @default(now())

  @@unique([conversationId, userId])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  content        String
  createdAt      DateTime     @default(now())

  @@map("messages")
}
