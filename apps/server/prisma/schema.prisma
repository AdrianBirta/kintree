generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model FamilyMember {
  id        String    @id @default(uuid())
  firstName String
  lastName  String
  gender    Gender?
  birthDate DateTime?
  deathDate DateTime?
  bio       String?
  imageUrl  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  parents  ParentChild[] @relation("ChildRelation")
  children ParentChild[] @relation("ParentRelation")

  partnersA Partnership[] @relation("PartnerA")
  partnersB Partnership[] @relation("PartnerB")

  @@map("family_members")
}

model ParentChild {
  id       String       @id @default(uuid())
  parent   FamilyMember @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    FamilyMember @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)
  childId  String

  @@unique([parentId, childId])
  @@map("parent_child")
}

model Partnership {
  id         String       @id @default(uuid())
  partnerA   FamilyMember @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerAId String
  partnerB   FamilyMember @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)
  partnerBId String

  status    PartnershipStatus @default(MARRIED)
  startDate DateTime?
  endDate   DateTime?

  @@unique([partnerAId, partnerBId])
  @@map("partnerships")
}

enum PartnershipStatus {
  MARRIED
  DIVORCED
  PARTNER
  WIDOWED
}
