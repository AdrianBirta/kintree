generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  USER
  ADMIN
}

model User {
  id        String @id @default(uuid())
  email     String @unique
  password  String
  firstName String
  lastName  String
  role      Role   @default(USER)

  refreshToken String? // hash-uit, folosit pentru validarea refresh-ului

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  familyMembers FamilyMember[]

  @@map("users")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum BloodType {
  A_POSITIVE
  A_NEGATIVE
  B_POSITIVE
  B_NEGATIVE
  AB_POSITIVE
  AB_NEGATIVE
  O_POSITIVE
  O_NEGATIVE
}

model FamilyMember {
  id          String           @id @default(uuid())
  firstName   String
  lastName    String
  maidenName  String?
  gender      Gender?
  birthDate   DateTime?
  deathDate   DateTime?
  imageUrl    String?
  bio         String?
  education   String?
  occupation  String?
  bloodType   BloodType?
  heightCm    Int?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  owner       User             @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  parents     ParentChild[]    @relation("ChildRelation")
  children    ParentChild[]    @relation("ParentRelation")
  partnersA   Partnership[]    @relation("PartnerA")
  partnersB   Partnership[]    @relation("PartnerB")
  manualOrder Int?
  manualRank  Int? // NOU: generația (rank-ul) forțată manual prin drag vertical
  alliancesA  FamilyAlliance[] @relation("AllianceA") // NOU
  alliancesB  FamilyAlliance[] @relation("AllianceB") // NOU

  @@map("family_members")
}

// NOU — de aici în jos, adăugat la finalul fișierului
enum AllianceType {
  CUSCRI
}

model FamilyAlliance {
  id               String       @id @default(uuid())
  memberA          FamilyMember @relation("AllianceA", fields: [memberAId], references: [id], onDelete: Cascade)
  memberAId        String
  memberB          FamilyMember @relation("AllianceB", fields: [memberBId], references: [id], onDelete: Cascade)
  memberBId        String
  type             AllianceType @default(CUSCRI)
  viaPartnershipId String? // parteneriatul copiilor care a generat această alianță
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@unique([memberAId, memberBId])
  @@map("family_alliances")
}

model ParentChild {
  id       String       @id @default(uuid())
  parent   FamilyMember @relation("ParentRelation", fields: [parentId], references: [id], onDelete: Cascade)
  parentId String
  child    FamilyMember @relation("ChildRelation", fields: [childId], references: [id], onDelete: Cascade)
  childId  String

  @@unique([parentId, childId])
  @@map("parent_child")
}

model Partnership {
  id         String       @id @default(uuid())
  partnerA   FamilyMember @relation("PartnerA", fields: [partnerAId], references: [id], onDelete: Cascade)
  partnerAId String
  partnerB   FamilyMember @relation("PartnerB", fields: [partnerBId], references: [id], onDelete: Cascade)
  partnerBId String

  status    PartnershipStatus @default(MARRIED)
  startDate DateTime?
  endDate   DateTime?

  @@unique([partnerAId, partnerBId])
  @@map("partnerships")
}

enum PartnershipStatus {
  MARRIED
  DIVORCED
  PARTNER
  WIDOWED
}
